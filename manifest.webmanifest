{
  "name": "Gerencial Familiar",
  "short_name": "Gerencial",
  "description": "Contas da casa: importe os extratos do banco, veja o painel do mês e envie o relatório.",
  "lang": "pt-BR",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f3f5f2",
  "theme_color": "#2f6f5e",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "./",
  "scope": "./",
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "application/x-ofx",
            "application/ofx",
            "text/csv",
            "text/plain",
            "text/comma-separated-values",
            "application/vnd.ms-excel",
            "application/octet-stream",
            ".ofx",
            ".csv",
            ".txt"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Importar extratos",
      "url": "./?ir=pasta"
    },
    {
      "name": "Relatório do mês",
      "url": "./?ir=relatorio"
    }
  ]
}